nextflow_process {

    name "Test DIFF_OUTPUTS"
    script "../modules/diff.nf"
    process "DIFF_OUTPUTS"

    test("reports the first changed text line") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'changed'],
                    'happy',
                    'result',
                    file("${projectDir}/tests/fixtures/diff/legacy/result.txt", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/diff/rust/result.txt", checkIfExists: true),
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert !comparison.ok
            assert comparison.differences.size() == 1
            assert comparison.differences[0].artifact == 'result.txt'
            assert comparison.differences[0].location == '/line/2'
            assert comparison.differences[0].expected == 'legacy value'
            assert comparison.differences[0].actual == 'rust value'
        }
    }

    test("ignores runtime VCF provenance but preserves header comparison") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'vcf_runtime_metadata'],
                    'prepy',
                    'result',
                    file("${projectDir}/tests/fixtures/diff/legacy/result.vcf", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/diff/rust/result.vcf", checkIfExists: true),
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert comparison.ok
            assert comparison.differences.isEmpty()
        }
    }

    test("ignores runtime container identity in runinfo JSON") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'runinfo_runtime_metadata'],
                    'happy',
                    'result',
                    file("${projectDir}/tests/fixtures/diff/legacy/result.runinfo.json", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/diff/rust/result.runinfo.json", checkIfExists: true),
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert comparison.ok
            assert comparison.differences.isEmpty()
        }
    }

    test("reports non-runtime VCF header differences") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'vcf_schema_difference'],
                    'prepy',
                    'schema',
                    file("${projectDir}/tests/fixtures/diff/legacy/schema.vcf", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/diff/rust/schema.vcf", checkIfExists: true),
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert !comparison.ok
            assert comparison.differences.size() == 1
            assert comparison.differences[0].artifact == 'schema.vcf'
            assert comparison.differences[0].location == '/line/2'
        }
    }

    test("ignores ROC row and metrics table order while preserving duplicates") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'roc_order'],
                    'happy',
                    'result',
                    [
                        file("${projectDir}/tests/fixtures/diff/roc-order/legacy/result.roc.all.csv", checkIfExists: true),
                        file("${projectDir}/tests/fixtures/diff/roc-order/legacy/result.metrics.json", checkIfExists: true),
                    ],
                    [
                        file("${projectDir}/tests/fixtures/diff/roc-order/rust/result.roc.all.csv", checkIfExists: true),
                        file("${projectDir}/tests/fixtures/diff/roc-order/rust/result.metrics.json", checkIfExists: true),
                    ],
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert comparison.ok
            assert comparison.differences.isEmpty()
        }
    }

    test("accepts bounded Rust ROC thresholds omitted by malformed legacy output") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'roc_additional'],
                    'happy',
                    'result',
                    [
                        file("${projectDir}/tests/fixtures/diff/roc-additional/legacy/result.roc.all.csv", checkIfExists: true),
                        file("${projectDir}/tests/fixtures/diff/roc-additional/legacy/result.metrics.json", checkIfExists: true),
                    ],
                    [
                        file("${projectDir}/tests/fixtures/diff/roc-additional/rust/result.roc.all.csv", checkIfExists: true),
                        file("${projectDir}/tests/fixtures/diff/roc-additional/rust/result.metrics.json", checkIfExists: true),
                    ],
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert comparison.ok
            assert comparison.differences.isEmpty()
        }
    }

    test("rejects missing ROC rows") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'roc_missing'],
                    'happy',
                    'result',
                    file("${projectDir}/tests/fixtures/diff/roc-missing/legacy/result.roc.all.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/diff/roc-missing/rust/result.roc.all.csv", checkIfExists: true),
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert !comparison.ok
            assert comparison.differences.size() == 1
            assert comparison.differences[0].kind == 'csv'
            assert comparison.differences[0].reason == 'CSV row multiplicities differ'
        }
    }

    test("rejects unbounded additional ROC thresholds") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'roc_unjustified'],
                    'happy',
                    'result',
                    file("${projectDir}/tests/fixtures/diff/roc-unjustified/legacy/result.roc.all.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/diff/roc-unjustified/rust/result.roc.all.csv", checkIfExists: true),
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert !comparison.ok
            assert comparison.differences.size() == 1
            assert comparison.differences[0].kind == 'csv'
            assert comparison.differences[0].reason == 'additional threshold is not bounded by legacy ROC points'
        }
    }

    test("rejects changed ROC row multiplicities") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'roc_duplicate'],
                    'happy',
                    'result',
                    file("${projectDir}/tests/fixtures/diff/roc-duplicate/legacy/result.roc.all.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/diff/roc-duplicate/rust/result.roc.all.csv", checkIfExists: true),
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert !comparison.ok
            assert comparison.differences.size() == 1
            assert comparison.differences[0].kind == 'csv'
            assert comparison.differences[0].expected.count == 2
            assert comparison.differences[0].actual.count == 1
        }
    }

    test("rejects duplicate additional ROC thresholds") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'roc_extra_duplicate'],
                    'happy',
                    'result',
                    file("${projectDir}/tests/fixtures/diff/roc-extra-duplicate/legacy/result.roc.all.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/diff/roc-extra-duplicate/rust/result.roc.all.csv", checkIfExists: true),
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert !comparison.ok
            assert comparison.differences.size() == 1
            assert comparison.differences[0].kind == 'csv'
            assert comparison.differences[0].reason == 'CSV row multiplicities differ'
            assert comparison.differences[0].expected.count == 0
            assert comparison.differences[0].actual.count == 2
        }
    }

    test("rejects changed ROC cell values") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'roc_changed'],
                    'happy',
                    'result',
                    file("${projectDir}/tests/fixtures/diff/roc-changed/legacy/result.roc.all.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/diff/roc-changed/rust/result.roc.all.csv", checkIfExists: true),
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert !comparison.ok
            assert comparison.differences.size() == 1
            assert comparison.differences[0].kind == 'csv'
            assert comparison.differences[0].expected.row[-1] == '2'
            assert comparison.differences[0].actual.row[-1] == '3'
        }
    }

    test("validates BCF content and companion CSI indexes semantically") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'bcf_and_index'],
                    'prepy',
                    'input',
                    [
                        file("${projectDir}/assets/fixtures/pre-matrix/input.bcf", checkIfExists: true),
                        file("${projectDir}/assets/fixtures/pre-matrix/input.bcf.csi", checkIfExists: true),
                    ],
                    [
                        file("${projectDir}/assets/fixtures/pre-matrix/input.bcf", checkIfExists: true),
                        file("${projectDir}/assets/fixtures/pre-matrix/input.bcf.csi", checkIfExists: true),
                    ],
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert comparison.ok
            assert comparison.differences.isEmpty()
        }
    }

    test("rejects invalid companion indexes") {

        when {
            process {
                """
                input[0] = Channel.of(tuple(
                    [id: 'invalid_index'],
                    'prepy',
                    'input',
                    [
                        file("${projectDir}/assets/fixtures/pre-matrix/input.bcf", checkIfExists: true),
                        file("${projectDir}/tests/fixtures/diff/invalid-index/input.bcf.csi", checkIfExists: true),
                    ],
                    [
                        file("${projectDir}/assets/fixtures/pre-matrix/input.bcf", checkIfExists: true),
                        file("${projectDir}/tests/fixtures/diff/invalid-index/input.bcf.csi", checkIfExists: true),
                    ],
                ))
                """
            }
        }

        then {
            def comparison = new groovy.json.JsonSlurper().parse(new File(process.out.comparison[0][2]))
            assert process.success
            assert !comparison.ok
            assert comparison.differences.size() == 1
            assert comparison.differences[0].artifact == 'input.bcf.csi'
            assert comparison.differences[0].kind == 'invalid'
        }
    }
}
