nextflow_pipeline {

    name "somatic allele-frequency type parity regression"
    script "../somatic_af_type_parity.nf"

    test("allele-frequency counts match pinned som.py for every type label") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def comparisonFile = new File(
                "$outputDir/sompy/somatic_af_type_parity/comparison.json"
            )
            assert comparisonFile.isFile() : 'comparison.json was not published'
            def comparison = new groovy.json.JsonSlurper().parse(comparisonFile)
            assert comparison.case_id == 'somatic_af_type_parity'
            assert comparison.lane == 'sompy'
            assert comparison.ok
            assert comparison.differences.isEmpty()
            assert workflow.success
        }
    }
}
