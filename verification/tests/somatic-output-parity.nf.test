nextflow_pipeline {

    name "somatic full-size output parity regression"
    script "../somatic_output_parity.nf"

    test("somatic output keeps full precision and complete AF rows") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def comparisonFile = new File("$outputDir/comparison.json")
            assert comparisonFile.isFile() : 'comparison.json was not published'
            def comparison = new groovy.json.JsonSlurper().parse(comparisonFile)
            assert comparison == [
                case_id: 'somatic_output_parity',
                lane: 'sompy',
                ok: true,
            ]
            assert workflow.success
        }
    }
}
