nextflow_pipeline {

    name "germline report output parity"
    script "../germline_output_parity.nf"

    test("legacy and Rust report artifacts have exact numeric parity") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def comparisonFile = new File("$outputDir/comparison.json")
            assert comparisonFile.isFile() : 'comparison.json was not published'
            def comparison = new groovy.json.JsonSlurper().parse(comparisonFile)
            assert comparison == [
                case_id: 'germline_output_parity',
                lane: 'happy',
                ok: true,
            ]
            assert workflow.success
        }
    }
}
