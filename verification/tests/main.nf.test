nextflow_pipeline {

    name "verification parity workflow"
    script "../main.nf"

    test("all selected lane cases have an empty structured difference list") {

        when {
            params {
                outdir = "$outputDir"
                cases = System.getenv('HAP_TEST_CASES') ?: 'happy,sompy,prepy,ftxpy,qfy,vcfcheck'
            }
        }

        then {
            def expectedCounts = [
                happy: 39,
                sompy: 27,
                prepy: 56,
                ftxpy: 25,
                qfy: 9,
                vcfcheck: 12,
            ]
            def selected = params.cases.toString().tokenize(',').collect { it.trim() }.findAll { it }
            def unknown = selected.toSet() - expectedCounts.keySet()

            assert unknown.isEmpty() : "unknown lanes: ${unknown.sort().join(', ')}"
            assert selected.size() == selected.toSet().size() : 'duplicate selected lanes'

            def verificationFile = new File("$outputDir/verification.json")
            assert verificationFile.isFile() : 'verification.json was not published'
            def verification = new groovy.json.JsonSlurper().parse(verificationFile)
            def comparisons = verification.comparisons
            def expectedTotal = selected.collect { expectedCounts[it] }.sum() ?: 0
            def identities = comparisons.collect { "${it.lane}:${it.case_id}" }

            assert verification.schema_version == 1
            assert verification.comparison_count == expectedTotal
            assert comparisons.size() == expectedTotal
            assert identities.size() == identities.toSet().size() : 'duplicate lane/case identities'
            assert comparisons.every { it.lane in selected }
            assert comparisons.every { it.ok instanceof Boolean && it.differences instanceof List }
            assert comparisons.every { it.ok && it.differences.isEmpty() } :
                groovy.json.JsonOutput.toJson(comparisons.findAll { !it.ok })

            def reportRows = new File("$outputDir/report.csv")
                .readLines('UTF-8')
                .drop(1)
                .findAll { it.trim() }
            assert reportRows.size() == expectedTotal
            assert workflow.success
        }
    }
}
