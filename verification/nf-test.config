// Harness toolchain pin: nf-test 0.9.5 with Nextflow 26.04.6.
// The nf-test CLI has no self-version constraint; install/run the pinned
// version documented in README.md. Nextflow is enforced by nextflow.config.
config {
    requires (
        "nf-test": "0.9.5"
    )

    testsDir "tests"
    workDir ".nf-test"
    configFile "nextflow.config"
    triggers '.*\\.nf\\.test$'

    // Opt in to Nextflow cache reuse without weakening clean CI runs:
    // NF_TEST_NEXTFLOW_OPTIONS=-resume nf-test test
    options System.getenv('NF_TEST_NEXTFLOW_OPTIONS') ?: ''

}
