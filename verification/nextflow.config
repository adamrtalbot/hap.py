// verification/nextflow.config
//
// Configuration for the hap.py <-> hap-rs parity pipeline.
//
// The legacy path runs inside the Wave-pinned reference container; the new
// path runs on the host using the locally-built `hap` binary. Any process
// whose name ends in `_LEGACY` inherits `params.legacy_image`; the
// comparator inherits `params.comparator_image` because it decides pass and
// fail; everything else inherits `container = null` so it uses the host
// environment.

// This harness is validated against the first stable strict-syntax release.
// The leading `!` turns a version mismatch into an error instead of a warning.
manifest {
    nextflowVersion = '!26.04.6'
}

params {
    // Samplesheets (CSV) — one per subcommand. Add rows to widen the
    // matrix; each row becomes an independent Nextflow task.
    happy_samplesheet    = "${projectDir}/assets/samplesheet.happy.csv"
    sompy_samplesheet    = "${projectDir}/assets/samplesheet.sompy.csv"
    prepy_samplesheet    = "${projectDir}/assets/samplesheet.prepy.csv"
    ftxpy_samplesheet    = "${projectDir}/assets/samplesheet.ftxpy.csv"
    qfy_samplesheet      = "${projectDir}/assets/samplesheet.qfy.csv"
    vcfcheck_samplesheet = "${projectDir}/assets/samplesheet.vcfcheck.csv"

    // Comma-separated release matrix. Override with `--cases` for focused
    // local diagnostics or HAP_TEST_CASES through nf-test.
    cases                = 'happy,sompy,prepy,ftxpy,qfy,vcfcheck'

    // Base prefix applied to every repo-relative path in the samplesheets.
    // Can be either a GitHub permalink (pinned for reproducibility) or
    // a local absolute path (e.g. '/path/to/hap.py') when developing
    // against a working checkout. Nextflow's native `file()` handles both
    // transparently: URLs are downloaded and cached; local paths are
    // symlinked into the task work directory.
    fixture_base         = 'https://raw.githubusercontent.com/Illumina/hap.py/84011695b2ff2406c16a335106db6831fb67fdfe'

    // The two pinned containers, each with a conda lock beside its recipe.
    // The legacy reference is the frozen Wave build of
    // containers/happy-0.3.15.yml and runs all six legacy tools unmodified.
    // The comparator is the frozen Wave build of containers/hap-comparator.yml;
    // it decides pass and fail, so it is pinned like the thing it judges
    // instead of running on host python3 and host bcftools.
    legacy_image         = 'community.wave.seqera.io/library/happy-0.3.15:2c2b5746d6b0da37'
    comparator_image     = 'community.wave.seqera.io/library/hap-comparator:3fd84dea2dc8fda1'

    outdir               = "${projectDir}/results"
}

docker.enabled = true

process {
    // New-implementation default: no container, host binaries on PATH.
    container     = null
    cpus          = 1
    memory        = 8.GB
    errorStrategy = 'finish'

    // Legacy reference processes opt in by name. Any process named
    // `*_LEGACY` gets the pinned hap.py+rtg-tools image.
    withName: '.*_LEGACY$' {
        container = params.legacy_image
    }

    // The comparator is aliased per lane at the include site, so the selector
    // has to match the aliases rather than the process name.
    withName: 'DIFF_.*' {
        container = params.comparator_image
    }
}
