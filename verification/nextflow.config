// verification/nextflow.config
//
// Configuration for the hap.py <-> hap-rs parity pipeline.
//
// The legacy path runs inside the Wave-pinned oracle container; the new
// path runs on the host using the locally-built `hap` binary. Everything
// is toggled by a single naming convention: any process whose name ends
// in `_LEGACY` inherits `params.legacy_image`; everything else inherits
// `container = null` so it uses the host environment.

// This harness is validated against the first stable strict-syntax release.
// The leading `!` turns a version mismatch into an error instead of a warning.
manifest {
    nextflowVersion = '!26.04.6'
}

params {
    // Samplesheets (CSV) — one per subcommand. Add rows to widen the
    // matrix; each row becomes an independent Nextflow task.
    happy_samplesheet    = "${projectDir}/assets/samplesheet.happy.csv"
    sompy_samplesheet    = "${projectDir}/assets/samplesheet.sompy.csv"
    prepy_samplesheet    = "${projectDir}/assets/samplesheet.prepy.csv"
    ftxpy_samplesheet    = "${projectDir}/assets/samplesheet.ftxpy.csv"
    qfy_samplesheet      = "${projectDir}/assets/samplesheet.qfy.csv"
    vcfcheck_samplesheet = "${projectDir}/assets/samplesheet.vcfcheck.csv"

    // Comma-separated release matrix. Override with `--cases` for focused
    // local diagnostics or HAP_TEST_CASES through nf-test.
    cases                = 'happy,sompy,prepy,ftxpy,qfy,vcfcheck'

    // Base prefix applied to every repo-relative path in the samplesheets.
    // Can be either a GitHub permalink (pinned for reproducibility) or
    // a local absolute path (e.g. '/path/to/hap.py') when developing
    // against a working checkout. Nextflow's native `file()` handles both
    // transparently: URLs are downloaded and cached; local paths are
    // symlinked into the task work directory.
    fixture_base         = 'https://raw.githubusercontent.com/Illumina/hap.py/84011695b2ff2406c16a335106db6831fb67fdfe'

    // Legacy oracle container (pinned in
    // .omx/plans/hap-single-binary-conversion-plan.md).
    legacy_image         = 'community.wave.seqera.io/library/hap.py_rtg-tools@sha256:1562a301d591cb42e4465465b579a68fc84429b8ed7c7cbda7f728f2e0a57be6'

    // Local Rust binary. HAP_BIN supplies the CI/default override; an explicit
    // --hap_bin parameter still takes normal Nextflow CLI precedence.
    hap_bin              = env('HAP_BIN') ?: "${projectDir}/../target/debug/hap"
    verify_bin           = env('VERIFY_BIN') ?: "${projectDir}/../target/debug/verify-fixtures"

    outdir               = "${projectDir}/results"
}

docker.enabled = true

process {
    // New-implementation default: no container, host binaries on PATH.
    container     = null
    cpus          = 2
    memory        = 8.GB
    errorStrategy = 'finish'

    // Legacy oracle processes opt in by name. Any process named
    // `*_LEGACY` gets the pinned hap.py+rtg-tools image.
    withName: '.*_LEGACY$' {
        container = params.legacy_image
    }

    // HAPPY_LEGACY override: runs single-threaded because hap.py's
    // BlockQuantify step has thread-races that produce non-deterministic
    // obs ordering and therefore non-deterministic ROC row filtering at
    // cluster-tied levels (~7-10 rows out of ~10000 differ between runs
    // of the same input). With `--threads 1` legacy becomes reproducible
    // and the CSV byte-equality check in the parity test passes
    // consistently. Slower than threads=2 for large inputs but bounded
    // (chr21 full chromosome ≈ 12 min vs 8 min); still fits in budget.
    // Keep the Rust invocation on the same governed thread count. Besides
    // making runinfo semantically comparable, this prevents the evaluation
    // harness itself from changing a command-line input between the two
    // implementations. The current Rust comparator is deterministic and does
    // not fan comparison work out by this value.
    withName: 'HAPPY_(LEGACY|RUST)' {
        cpus = 1
    }

    // Isolate the resource-sensitive legacy reports. A parallel matrix once
    // produced a truncated roc.all row even with --threads 1. Runtime failures
    // remain retryable here; the host-side Rust comparator independently
    // rejects structurally corrupt legacy ROC output.
    withName: HAPPY_LEGACY {
        maxForks      = 1
        errorStrategy = 'retry'
        maxRetries    = 1
    }
}
